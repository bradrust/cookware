---
import { FORMSPREE_ENDPOINT } from "../lib/config";

const enabled = Boolean(FORMSPREE_ENDPOINT);
---

<section class="rounded-2xl bg-neutral-900 text-white p-8 my-12">
  <div class="max-w-xl">
    <h2 class="text-2xl font-display font-bold">
      Get next week's 15-minute dinner in your inbox.
    </h2>
    <p class="mt-2 text-neutral-300">
      One recipe every Sunday. No spam, unsubscribe anytime.
    </p>

    {
      enabled ? (
        <form
          action={FORMSPREE_ENDPOINT}
          method="POST"
          class="mt-5 flex flex-col sm:flex-row gap-3"
        >
          <label class="sr-only" for="email">
            Email address
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="flex-1 rounded-lg px-4 py-3 text-neutral-900 placeholder:text-neutral-400"
          />
          <button type="submit" class="btn-primary">
            Subscribe
          </button>
          <input type="hidden" name="_subject" value="New newsletter signup" />
        </form>
      ) : (
        <p class="mt-5 text-sm text-neutral-400 italic">
          Signup coming soon — set FORMSPREE_ENDPOINT in src/lib/config.ts to
          enable this form.
        </p>
      )
    }
  </div>
</section>
