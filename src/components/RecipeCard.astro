---
import type { CollectionEntry } from "astro:content";
import CategoryBadges from "./CategoryBadges.astro";
import FavoriteButton from "./FavoriteButton.astro";
import { link } from "../lib/link";

type Props = {
  recipe: CollectionEntry<"recipes">;
  /** Hide badges of this type — used on the category landing page */
  hideBadgeType?: string;
  /** Suppress the heart button (e.g. on the /saved page listing) */
  hideFavorite?: boolean;
};

const { recipe, hideBadgeType, hideFavorite = false } = Astro.props;
const { title, description, heroImage, prepMinutes, cookMinutes, servings } =
  recipe.data;
const totalMin = prepMinutes + cookMinutes;
const slug = recipe.slug;
---

<div class="relative group" data-recipe-slug={slug}>
  <a
    href={link(`/recipes/${slug}`)}
    class="block rounded-2xl overflow-hidden border border-neutral-200 hover:border-brand-500 transition no-underline"
  >
    <div class="aspect-[4/3] bg-neutral-100 overflow-hidden">
      {
        heroImage ? (
          <img
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-neutral-400 font-display text-4xl">
            🍽
          </div>
        )
      }
    </div>
    <div class="p-5 space-y-2">
      <h3 class="font-display font-bold text-lg text-neutral-900 group-hover:text-brand-700">
        {title}
      </h3>
      <p class="text-sm text-neutral-600 line-clamp-2">{description}</p>
      <div class="flex items-center gap-4 text-xs text-neutral-500 pt-2">
        <span>⏱ {totalMin} min</span>
        <span>🍴 Serves {servings}</span>
      </div>
      <div class="pt-2">
        <CategoryBadges
          recipe={recipe}
          limit={4}
          size="sm"
          exclude={hideBadgeType ? [hideBadgeType] : []}
        />
      </div>
    </div>
  </a>

  {
    !hideFavorite && (
      <div class="absolute top-3 right-3">
        <FavoriteButton slug={slug} size="sm" />
      </div>
    )
  }
</div>
