---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";

// We render every non-draft recipe card into the page, each hidden. The
// small script below reads localStorage and shows only the matching ones.
// Fully static; works with any host (GitHub Pages, Netlify, anywhere).
const recipes = (await getCollection("recipes")).filter((r) => !r.data.draft);
---

<Layout
  title="Saved recipes"
  description="Your saved recipes — stored locally in this browser."
>
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-8">
    <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight">
      Saved recipes
    </h1>
    <p class="mt-3 text-neutral-600 max-w-prose">
      Recipes you've saved on this device.
      <span class="text-neutral-500 text-sm block mt-2">
        Saves live in this browser only — no login, no server. Clear your browser
        data and they're gone; open in another device and they don't appear.
      </span>
    </p>
    <p class="mt-4">
      <span data-role="count" class="text-sm text-neutral-500">Loading…</span>
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-24">
    <div
      data-role="empty"
      class="hidden text-center py-16 text-neutral-500 border border-dashed border-neutral-300 rounded-2xl"
    >
      <p class="text-lg">Nothing saved yet.</p>
      <p class="mt-2 text-sm">
        Tap the ♡ on any recipe to save it here.
      </p>
      <p class="mt-4">
        <a href="/" class="text-brand-700">Browse recipes →</a>
      </p>
    </div>

    <div data-role="grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        recipes.map((recipe) => (
          <div class="saved-item hidden" data-slug={recipe.slug}>
            <RecipeCard recipe={recipe} hideFavorite />
          </div>
        ))
      }
    </div>
  </section>

  <script>
    import { readFavorites, onFavoritesChanged } from "../lib/favorites-client";

    function render(favs: string[]) {
      const items = document.querySelectorAll<HTMLDivElement>(".saved-item");
      let shown = 0;
      items.forEach((el) => {
        const slug = el.dataset.slug;
        const on = slug ? favs.includes(slug) : false;
        el.classList.toggle("hidden", !on);
        if (on) shown++;
      });
      const empty = document.querySelector<HTMLDivElement>('[data-role="empty"]');
      const grid = document.querySelector<HTMLDivElement>('[data-role="grid"]');
      const count = document.querySelector<HTMLSpanElement>('[data-role="count"]');
      if (empty) empty.classList.toggle("hidden", shown > 0);
      if (grid) grid.classList.toggle("hidden", shown === 0);
      if (count) {
        count.textContent =
          shown === 0
            ? ""
            : `${shown} saved recipe${shown === 1 ? "" : "s"}.`;
      }
    }

    render(readFavorites());
    onFavoritesChanged(render);
  </script>
</Layout>
