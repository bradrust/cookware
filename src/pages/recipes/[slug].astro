---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ShopButtons from "../../components/ShopButtons.astro";
import IngredientList from "../../components/IngredientList.astro";
import CookwareList from "../../components/CookwareList.astro";
import EmailSignup from "../../components/EmailSignup.astro";
import CategoryBadges from "../../components/CategoryBadges.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import SocialActions from "../../components/SocialActions.astro";
import FavoriteButton from "../../components/FavoriteButton.astro";
import { relatedRecipes } from "../../lib/recipeCategories";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes
    .filter((r) => !r.data.draft)
    .map((recipe) => ({
      params: { slug: recipe.slug },
      props: { recipe },
    }));
}

type Props = { recipe: CollectionEntry<"recipes"> };
const { recipe } = Astro.props;
const { Content } = await recipe.render();

const allRecipes = await getCollection("recipes");
const related = relatedRecipes(allRecipes, recipe, 3);

const {
  title,
  description,
  heroImage,
  videoUrl,
  prepMinutes,
  cookMinutes,
  servings,
  ingredients,
  cookware,
  publishedAt,
} = recipe.data;

const totalMin = prepMinutes + cookMinutes;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: title,
  description,
  image: heroImage ? [new URL(heroImage, Astro.site).toString()] : undefined,
  datePublished: publishedAt.toISOString(),
  prepTime: `PT${prepMinutes}M`,
  cookTime: `PT${cookMinutes}M`,
  totalTime: `PT${totalMin}M`,
  recipeYield: `${servings} servings`,
  recipeIngredient: ingredients.map((i) =>
    i.quantity ? `${i.quantity} ${i.name}` : i.name,
  ),
  recipeCuisine: recipe.data.cuisine,
  recipeCategory: recipe.data.mealType,
  suitableForDiet: recipe.data.dietary.map(
    (d) =>
      ({
        vegetarian: "https://schema.org/VegetarianDiet",
        vegan: "https://schema.org/VeganDiet",
        keto: "https://schema.org/KetogenicDiet",
        "low-carb": "https://schema.org/LowCarbDiet",
        "gluten-free": "https://schema.org/GlutenFreeDiet",
        "dairy-free": "https://schema.org/LowLactoseDiet",
        "low-sodium": "https://schema.org/LowSaltDiet",
      })[d] ?? undefined,
  ).filter(Boolean),
};
---

<Layout title={title} description={description} image={heroImage}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-6">
      <div class="flex items-start justify-between gap-4">
        <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight">
          {title}
        </h1>
        <div class="shrink-0 pt-2 not-print">
          <FavoriteButton slug={recipe.slug} />
        </div>
      </div>
      <p class="mt-3 text-lg text-neutral-600">{description}</p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-neutral-500">
        <span>⏱ Prep: {prepMinutes} min</span>
        <span>🔥 Cook: {cookMinutes} min</span>
        <span>🍴 Serves: {servings}</span>
      </div>
      <div class="mt-4">
        <CategoryBadges recipe={recipe} />
      </div>
      <SocialActions
        title={title}
        description={description}
        url={new URL(Astro.url.pathname, Astro.site).toString()}
        image={heroImage}
      />
    </header>

    {
      heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="w-full rounded-2xl mb-8 aspect-[16/10] object-cover"
        />
      )
    }

    {
      videoUrl && (
        <p class="mb-8">
          <a
            href={videoUrl}
            target="_blank"
            rel="noopener"
            class="btn-secondary"
          >
            ▶ Watch on YouTube
          </a>
        </p>
      )
    }

    <ShopButtons ingredients={ingredients} />

    <div class="mt-12 grid gap-12 md:grid-cols-2">
      <IngredientList ingredients={ingredients} />
      <div>
        <h2 class="text-2xl font-display font-bold mb-4">Instructions</h2>
        <div class="recipe-body">
          <Content />
        </div>
      </div>
    </div>

    {cookware.length > 0 && <div class="mt-16"><CookwareList items={cookware} /></div>}

    {
      related.length > 0 && (
        <section class="mt-20">
          <h2 class="font-display text-2xl font-bold mb-6">You might also like</h2>
          <div class="grid gap-6 sm:grid-cols-3">
            {related.map((r) => <RecipeCard recipe={r} />)}
          </div>
        </section>
      )
    }

    <EmailSignup />
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
