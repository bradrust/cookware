# Copy this file to `.env` for local dev.
# For production, set these in your host's environment settings
# (GitHub Pages doesn't have env vars — see README for the workaround).
#
# Anything prefixed PUBLIC_ is exposed to the browser bundle.
# Anything else stays server-only.

# YouTube Data API v3 key (optional — only needed if adding live widgets)
PUBLIC_YOUTUBE_API_KEY=

# Mailgun / Resend key (optional — only if you add real email sending later)
MAILGUN_API_KEY=
